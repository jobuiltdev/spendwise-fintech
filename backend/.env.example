# Copy this file to .env and fill in real values for your machine.
# .env is gitignored on purpose — never commit actual secrets.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

DEBUG=True

# Comma-separated list, e.g. localhost,127.0.0.1,your-lan-ip
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset to use the project's default SQLite file — that is the
# normal local setup and needs nothing installed.
#
# To develop or test against the local PostgreSQL from docker-compose.yml
# (`docker compose up -d db`), set:
#   DATABASE_URL=postgres://spendwise:spendwise@localhost:55433/spendwise
#
# Those are throwaway local credentials. Never commit real ones.
# DATABASE_URL=

# Leave unset in development — CORS_ALLOW_ALL_ORIGINS defaults to whatever
# DEBUG is set to. Set a comma-separated origin list here for production.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# "Sign in with Google" OAuth client ID (Web application type), from
# https://console.cloud.google.com/apis/credentials. Leave unset to disable
# the /api/token/google/ endpoint.
GOOGLE_OAUTH_CLIENT_ID=
